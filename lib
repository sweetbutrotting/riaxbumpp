		b.MouseLeave:Connect(function() tween(b, 0.12, { BackgroundColor3 = normal }) end)
	end
	hoverBtn(minBtn, T.Element, T.ElementHover)
	hoverBtn(closeBtn, T.Element, T.Danger)

	create("Frame", {
		BackgroundColor3 = T.Stroke, Position = UDim2.new(0, 10, 0, TOP - 1), Size = UDim2.new(1, -20, 0, 1), Parent = Main,
	})

	-- body
	local Body = create("Frame", {
		Name = "Body", BackgroundTransparency = 1, Position = UDim2.fromOffset(0, TOP),
		Size = UDim2.new(1, 0, 0, height - TOP), Parent = Main,
	})

	local Sidebar = create("Frame", {
		BackgroundColor3 = T.Sidebar, Position = UDim2.fromOffset(10, 2), Size = UDim2.new(0, 150, 1, -12), Parent = Body,
	})
	corner(Sidebar, 8)

	local TabList = create("ScrollingFrame", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(6, 6), Size = UDim2.new(1, -12, 1, -74),
		ScrollBarThickness = 0, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, Parent = Sidebar,
	})
	vlist(TabList, 4)

	-- welcome / user card
	local UserCard = create("Frame", {
		BackgroundColor3 = T.Element, Position = UDim2.new(0, 6, 1, -62), Size = UDim2.new(1, -12, 0, 56), Parent = Sidebar,
	})
	corner(UserCard, 8)
	local avatar = create("ImageLabel", {
		BackgroundColor3 = T.Track, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 8, 0.5, 0),
		Size = UDim2.fromOffset(36, 36), Parent = UserCard,
	})
	corner(avatar, 18)
	create("TextLabel", {
		BackgroundTransparency = 1, Text = "Welcome back,", TextColor3 = T.SubText, TextSize = 11, TextXAlignment = LEFT,
		Position = UDim2.fromOffset(52, 10), Size = UDim2.new(1, -58, 0, 13), Parent = UserCard,
	})
	create("TextLabel", {
		BackgroundTransparency = 1, Text = LocalPlayer.DisplayName, Font = FONT_BOLD, TextSize = 13, TextXAlignment = LEFT,
		TextTruncate = Enum.TextTruncate.AtEnd, Position = UDim2.fromOffset(52, 25), Size = UDim2.new(1, -58, 0, 18),
		Parent = UserCard,
	})
	task.spawn(function()
		local ok, img = pcall(function()
			return Players:GetUserThumbnailAsync(LocalPlayer.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
		end)
		if ok and avatar.Parent then avatar.Image = img end
	end)

	local Pages = create("Frame", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(168, 2), Size = UDim2.new(1, -178, 1, -12), Parent = Body,
	})

	-- notification holder
	local NotifHolder = create("Frame", {
		BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -16, 1, -16),
		Size = UDim2.new(0, 280, 1, -32), Parent = gui,
	})
	create("UIListLayout", {
		Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder,
		VerticalAlignment = Enum.VerticalAlignment.Bottom, Parent = NotifHolder,
	})

	------------------------------------------------------------ element builders
	local Elements = {}

	local function newRow(parent, h)
		local row = create("Frame", {
			BackgroundColor3 = T.Element, Size = UDim2.new(1, 0, 0, h or 36), LayoutOrder = nextOrder(parent), Parent = parent,
		})
		corner(row, 6)
		return row
	end

	local function rowLabel(row, text, size)
		return create("TextLabel", {
			BackgroundTransparency = 1, Text = text, TextXAlignment = LEFT, TextTruncate = Enum.TextTruncate.AtEnd,
			Position = UDim2.fromOffset(12, 0), Size = size or UDim2.new(1, -24, 0, 36), Parent = row,
		})
	end

	local function hoverRow(row, hit)
		hit.MouseEnter:Connect(function() tween(row, 0.12, { BackgroundColor3 = T.ElementHover }) end)
		hit.MouseLeave:Connect(function() tween(row, 0.12, { BackgroundColor3 = T.Element }) end)
	end

	local function setFlag(o, value)
		if o.Flag then Library.Flags[o.Flag] = value end
	end

	-- SECTION
	Elements.AddSection = function(parent, o)
		local name = type(o) == "table" and (o.Name or "") or o
		local lbl = create("TextLabel", {
			BackgroundTransparency = 1, Text = string.upper(tostring(name)), Font = FONT_BOLD, TextSize = 11,
			TextXAlignment = LEFT, Size = UDim2.new(1, 0, 0, 24), LayoutOrder = nextOrder(parent), Parent = parent,
		})
		padding(lbl, 4, 8, 0, 0)
		onAccent(function() lbl.TextColor3 = Window.Accent end)
		return { Set = function(_, text) lbl.Text = string.upper(tostring(text)) end }
	end

	-- LABEL
	Elements.AddLabel = function(parent, o)
		if type(o) == "string" then o = { Text = o } end
		local row = create("Frame", {
			BackgroundColor3 = T.Element, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = nextOrder(parent), Parent = parent,
		})
		corner(row, 6)
		padding(row, 12, 10, 12, 10)
		local lbl = create("TextLabel", {
			BackgroundTransparency = 1, Text = o.Text or "", TextColor3 = T.SubText, TextWrapped = true,
			TextXAlignment = LEFT, TextYAlignment = Enum.TextYAlignment.Top,
			Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = row,
		})
		return { Set = function(_, text) lbl.Text = text end }
	end

	-- BUTTON
	Elements.AddButton = function(parent, o)
		local row = newRow(parent, 36)
		local flash = create("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = row })
		corner(flash, 6)
		rowLabel(row, o.Name or "Button")
		local dot = create("Frame", {
			AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0.5, 0), Size = UDim2.fromOffset(8, 8), Parent = row,
		})
		corner(dot, 4)
		onAccent(function()
			flash.BackgroundColor3 = Window.Accent
			dot.BackgroundColor3 = Window.Accent
		end)
		local hit = hitbox(row)
		hoverRow(row, hit)
		local obj = {}
		function obj:Fire()
			flash.BackgroundTransparency = 0.7
			tween(flash, 0.45, { BackgroundTransparency = 1 })
			if o.Callback then task.spawn(o.Callback) end
		end
		hit.Activated:Connect(function() obj:Fire() end)
		return obj
	end

	-- TOGGLE
	Elements.AddToggle = function(parent, o)
		local obj = { Value = o.Default == true }
		local row = newRow(parent, 36)
		rowLabel(row, o.Name or "Toggle", UDim2.new(1, -70, 0, 36))
		local track = create("Frame", {
			BackgroundColor3 = T.Track, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0),
			Size = UDim2.fromOffset(38, 20), Parent = row,
		})
		corner(track, 10)
		local knob = create("Frame", {
			BackgroundColor3 = WHITE, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 3, 0.5, 0),
			Size = UDim2.fromOffset(14, 14), Parent = track,
		})
		corner(knob, 7)
		local hit = hitbox(row)
		hoverRow(row, hit)

		local function render(animate)
			local on = obj.Value
			apply(track, { BackgroundColor3 = on and Window.Accent or T.Track }, animate, 0.2)
			apply(knob, { Position = on and UDim2.new(1, -17, 0.5, 0) or UDim2.new(0, 3, 0.5, 0) }, animate, 0.2)
		end
		onAccent(function() render(false) end)
		setFlag(o, obj.Value)

		function obj:Set(v, silent)
			self.Value = v and true or false
			setFlag(o, self.Value)
			render(true)
			if not silent and o.Callback then task.spawn(o.Callback, self.Value) end
		end
		function obj:Toggle() self:Set(not self.Value) end
		hit.Activated:Connect(function() obj:Toggle() end)
		return obj
	end

	-- SLIDER
	Elements.AddSlider = function(parent, o)
		local min, max, inc = o.Min or 0, o.Max or 100, o.Increment or 1
		local suffix = o.Suffix or ""
		local obj = { Value = min }
		local row = newRow(parent, 50)
		create("TextLabel", {
			BackgroundTransparency = 1, Text = o.Name or "Slider", TextXAlignment = LEFT, TextTruncate = Enum.TextTruncate.AtEnd,
			Position = UDim2.fromOffset(12, 7), Size = UDim2.new(1, -96, 0, 18), Parent = row,
		})
		local valLbl = create("TextLabel", {
			BackgroundTransparency = 1, Font = FONT_BOLD, TextXAlignment = RIGHT, AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -12, 0, 7), Size = UDim2.fromOffset(74, 18), Parent = row,
		})
		local bar = create("Frame", {
			BackgroundColor3 = T.Track, Position = UDim2.fromOffset(12, 33), Size = UDim2.new(1, -24, 0, 6), Parent = row,
		})
		corner(bar, 3)
		local fill = create("Frame", { Size = UDim2.new(0, 0, 1, 0), Parent = bar })
		corner(fill, 3)
		local knob = create("Frame", {
			BackgroundColor3 = WHITE, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
			Size = UDim2.fromOffset(12, 12), ZIndex = 2, Parent = fill,
		})
		corner(knob, 6)
		onAccent(function()
			fill.BackgroundColor3 = Window.Accent
			valLbl.TextColor3 = Window.Accent
		end)

		local function snap(x)
			x = math.clamp(x, min, max)
			x = min + math.floor((x - min) / inc + 0.5) * inc
			return math.clamp(tonumber(string.format("%.4f", x)), min, max)
		end
		local function render(animate)
			local alpha = (max - min) == 0 and 0 or (obj.Value - min) / (max - min)
			valLbl.Text = tostring(obj.Value) .. suffix
			apply(fill, { Size = UDim2.new(alpha, 0, 1, 0) }, animate, 0.1)
		end

		function obj:Set(x, silent)
			x = snap(x)
			local changed = x ~= self.Value
			self.Value = x
			setFlag(o, x)
			render(true)
			if changed and not silent and o.Callback then task.spawn(o.Callback, x) end
		end

		obj.Value = snap(o.Default or min)
		setFlag(o, obj.Value)
		render(false)

		local hit = hitbox(row, UDim2.new(1, 0, 0, 28))
		hit.Position = UDim2.fromOffset(0, 22)
		hoverRow(row, hit)
		drag(hit, function(pos)
			local a = math.clamp((pos.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
			obj:Set(min + (max - min) * a)
		end)
		return obj
	end

	-- DROPDOWN
	Elements.AddDropdown = function(parent, o)
		local options = o.Options or {}
		local obj = { Value = o.Default, Open = false }
		local row = newRow(parent, 36)
		row.ClipsDescendants = true
		rowLabel(row, o.Name or "Dropdown", UDim2.new(0.5, -12, 0, 36))
		local valueLbl = create("TextLabel", {
			BackgroundTransparency = 1, Font = FONT_BOLD, TextXAlignment = RIGHT, TextTruncate = Enum.TextTruncate.AtEnd,
			AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -30, 0, 0), Size = UDim2.new(0.5, -34, 0, 36), Parent = row,
		})
		local arrow = create("TextLabel", {
			BackgroundTransparency = 1, Text = "v", TextColor3 = T.SubText, Font = FONT_BOLD, TextSize = 12,
			AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 0), Size = UDim2.fromOffset(14, 36), Parent = row,
		})
		local listFrame = create("ScrollingFrame", {
			BackgroundColor3 = T.Background, Position = UDim2.fromOffset(8, 42), Size = UDim2.new(1, -16, 0, 0),
			ScrollBarThickness = 2, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, Parent = row,
		})
		corner(listFrame, 6)
		padding(listFrame, 4)
		vlist(listFrame, 3)
		local hit = hitbox(row, UDim2.new(1, 0, 0, 36))
		hoverRow(row, hit)

		local buttons = {}
		local function listHeight() return math.min(#options * 31 + 5, 150) end
		local function paintOptions()
			for _, entry in ipairs(buttons) do
				entry.button.TextColor3 = (entry.value == obj.Value) and Window.Accent or T.SubText
			end
		end
		local function setOpen(open)
			obj.Open = open
			tween(row, 0.25, { Size = UDim2.new(1, 0, 0, open and (42 + listHeight() + 8) or 36) })
			tween(arrow, 0.25, { Rotation = open and 180 or 0 })
		end
		local function build()
			for _, c in ipairs(listFrame:GetChildren()) do
				if c:IsA("TextButton") then c:Destroy() end
			end
			buttons = {}
			for i, opt in ipairs(options) do
				local b = create("TextButton", {
					BackgroundColor3 = T.Element, Text = tostring(opt), TextColor3 = T.SubText,
					Size = UDim2.new(1, 0, 0, 28), LayoutOrder = i, Parent = listFrame,
				})
				corner(b, 5)
				table.insert(buttons, { button = b, value = opt })
				b.MouseEnter:Connect(function() tween(b, 0.1, { BackgroundColor3 = T.ElementHover }) end)
				b.MouseLeave:Connect(function() tween(b, 0.1, { BackgroundColor3 = T.Element }) end)
				b.Activated:Connect(function()
					obj:Set(opt)
					setOpen(false)
				end)
			end
			listFrame.Size = UDim2.new(1, -16, 0, listHeight())
			paintOptions()
			if obj.Open then row.Size = UDim2.new(1, 0, 0, 42 + listHeight() + 8) end
		end

		function obj:Set(v, silent)
			self.Value = v
			valueLbl.Text = v ~= nil and tostring(v) or "None"
			setFlag(o, v)
			paintOptions()
			if not silent and o.Callback then task.spawn(o.Callback, v) end
		end
		function obj:Refresh(newOptions)
			options = newOptions or {}
			build()
		end

		onAccent(function()
			valueLbl.TextColor3 = Window.Accent
			paintOptions()
		end)
		build()
		obj:Set(o.Default, true)
		hit.Activated:Connect(function() setOpen(not obj.Open) end)
		return obj
	end

	-- KEYBIND
	Elements.AddKeybind = function(parent, o)
		local obj = { Value = o.Default or Enum.KeyCode.Unknown }
		local row = newRow(parent, 36)
		rowLabel(row, o.Name or "Keybind", UDim2.new(1, -110, 0, 36))
		local keyBtn = create("TextButton", {
			Font = FONT_BOLD, TextSize = 12, BackgroundColor3 = T.Track, AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(84, 24), Parent = row,
		})
		corner(keyBtn, 5)
		hoverRow(row, keyBtn)
		local listening = false
		local function render()
			if listening then
				keyBtn.Text = "..."
				keyBtn.TextColor3 = T.Text
			else
				keyBtn.Text = obj.Value == Enum.KeyCode.Unknown and "None" or obj.Value.Name
				keyBtn.TextColor3 = Window.Accent
			end
		end
		onAccent(render)
		setFlag(o, obj.Value)

		function obj:Set(key, silent)
			self.Value = key
			setFlag(o, key)
			render()
			if not silent and o.Changed then task.spawn(o.Changed, key) end
		end

		keyBtn.Activated:Connect(function()
			if listening then return end
			listening = true
			Window._listening = Window._listening + 1
			render()
		end)
		connect(UserInputService.InputBegan, function(input, gpe)
			if listening then
				if input.UserInputType == Enum.UserInputType.Keyboard then
					listening = false
					task.defer(function() Window._listening = Window._listening - 1 end)
					if input.KeyCode ~= Enum.KeyCode.Escape then obj:Set(input.KeyCode) else render() end
				end
				return
			end
			if gpe then return end
			if obj.Value ~= Enum.KeyCode.Unknown and input.KeyCode == obj.Value and o.Callback then
				task.spawn(o.Callback)
			end
		end)
		return obj
	end

	-- TEXTBOX
	Elements.AddTextbox = function(parent, o)
		local obj = { Value = o.Default or "" }
		local row = newRow(parent, 36)
		rowLabel(row, o.Name or "Textbox", UDim2.new(1, -176, 0, 36))
		local box = create("TextBox", {
			BackgroundColor3 = T.Track, Text = obj.Value, PlaceholderText = o.Placeholder or "Type here...",
			PlaceholderColor3 = T.SubText, ClearTextOnFocus = false, TextSize = 12, TextXAlignment = LEFT,
			TextTruncate = Enum.TextTruncate.AtEnd, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0),
			Size = UDim2.fromOffset(156, 24), Parent = row,
		})
		corner(box, 5)
		padding(box, 8, 0, 8, 0)
		local st = stroke(box, T.Track, 1)
		box.Focused:Connect(function() tween(st, 0.15, { Color = Window.Accent }) end)
		box.FocusLost:Connect(function(enter)
			tween(st, 0.15, { Color = T.Track })
			local text = box.Text
			if o.Numeric then
				local n = tonumber(text)
				if not n then
					box.Text = tostring(obj.Value)
					return
				end
				text = n
			end
			obj.Value = text
			setFlag(o, text)
			if o.Callback then task.spawn(o.Callback, text, enter) end
		end)
		function obj:Set(text, silent)
			self.Value = text
			box.Text = tostring(text)
			setFlag(o, text)
			if not silent and o.Callback then task.spawn(o.Callback, text, false) end
		end
		setFlag(o, obj.Value)
		return obj
	end

