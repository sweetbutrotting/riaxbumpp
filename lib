	local titleLbl = create("TextLabel", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(16, 0), Size = UDim2.new(1, -110, 1, 0),
		Font = FONT_BOLD, TextSize = 14, TextXAlignment = LEFT, RichText = true, Parent = Topbar,
	})
	onAccent(function()
		local sub = ""
		if subtitle ~= "" then
			sub = ' <font color="#6f6580">|</font> <font color="#' .. Window.Accent:ToHex() .. '">' .. esc(subtitle) .. "</font>"
		end
