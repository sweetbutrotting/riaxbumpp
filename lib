		local hexBox = create("TextBox", {
			BackgroundColor3 = T.Track, Font = FONT_BOLD, TextSize = 12, ClearTextOnFocus = false,
			Position = UDim2.fromOffset(0, 142), Size = UDim2.new(0.45, -4, 0, 26), Parent = panel,
		})
		corner(hexBox, 6)
		local rgbLbl = create("TextLabel", {
			BackgroundTransparency = 1, TextColor3 = T.SubText, TextSize = 12, TextXAlignment = RIGHT,
			Position = UDim2.new(0.45, 4, 0, 142), Size = UDim2.new(0.55, -4, 0, 26), Parent = panel,
