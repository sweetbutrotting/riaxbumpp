 --[[
	PinkLib  -  a clean UI library for Roblox  (LocalScript)

	WHERE TO PUT IT
	  StarterPlayer > StarterPlayerScripts > LocalScript  (paste this whole file)

	WHAT YOU GET
	  - Draggable window (drag the top bar), minimize "-" and close "x"
	  - Sidebar tabs with smooth page transitions
	  - "Welcome" user card (avatar + display name) and a welcome notification
	  - Hide / show keybind (default RightShift) that you can rebind in Settings
	  - Elements: Section, Label, Button, Toggle, Slider, Dropdown, Keybind,
	              Textbox, ColorPicker (saturation/value box + hue bar + hex input)
	  - Live accent color: the color picker in Settings recolors the whole UI
	  - Notifications, mobile open button, auto-fit on small screens

	USING IT AS A MODULE
	  Cut everything above the "EXAMPLE" marker into a ModuleScript, add
	  `return Library` at the bottom, and require() it from your LocalScript.

	QUICK API
	  local Window = Library:CreateWindow({ Title = "Pinkie", Subtitle = "Hub", ToggleKey = Enum.KeyCode.RightShift })
	  local Tab = Window:CreateTab("Main")
	  Tab:AddSection("Name")
	  Tab:AddLabel("text")
	  Tab:AddButton({ Name = "", Callback = function() end })
	  Tab:AddToggle({ Name = "", Default = false, Flag = "x", Callback = function(on) end })
	  Tab:AddSlider({ Name = "", Min = 0, Max = 100, Default = 50, Increment = 1, Suffix = "", Callback = function(v) end })
	  Tab:AddDropdown({ Name = "", Options = { "A", "B" }, Default = "A", Callback = function(v) end })
	  Tab:AddKeybind({ Name = "", Default = Enum.KeyCode.E, Callback = function() end, Changed = function(key) end })
	  Tab:AddTextbox({ Name = "", Placeholder = "", Callback = function(text, enterPressed) end })
	  Tab:AddColorPicker({ Name = "", Default = Color3.fromRGB(255, 143, 186), Callback = function(color) end })
	  Window:Notify({ Title = "", Content = "", Duration = 4 })
	  Window:SetAccent(Color3) / Window:SetToggleKey(Enum.KeyCode.X) / Window:Toggle() / Window:Destroy()
	  Every element returns an object with :Set(value) and .Value. Library.Flags[flag] holds live values.
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

---------------------------------------------------------------- theme
local T = {
	Background = Color3.fromRGB(22, 19, 27),
	Sidebar = Color3.fromRGB(28, 24, 34),
	Element = Color3.fromRGB(36, 31, 43),
	ElementHover = Color3.fromRGB(45, 39, 53),
	Track = Color3.fromRGB(52, 45, 61),
	Stroke = Color3.fromRGB(56, 49, 66),
	Text = Color3.fromRGB(246, 240, 249),
	SubText = Color3.fromRGB(156, 146, 168),
	OnAccent = Color3.fromRGB(41, 22, 33),
	Danger = Color3.fromRGB(236, 96, 112),
}
local FONT = Enum.Font.GothamMedium
local FONT_BOLD = Enum.Font.GothamBold
local WHITE = Color3.new(1, 1, 1)
local LEFT = Enum.TextXAlignment.Left
local RIGHT = Enum.TextXAlignment.Right

---------------------------------------------------------------- helpers
local function tween(obj, time, goal, style, dir)
	local t = TweenService:Create(obj, TweenInfo.new(time, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), goal)
	t:Play()
	return t
end

local function apply(obj, goal, animate, time)
	if animate then
		tween(obj, time or 0.18, goal)
	else
		for k, v in pairs(goal) do obj[k] = v end
	end
end

local function create(class, props, children)
	local inst = Instance.new(class)
	if inst:IsA("GuiObject") then inst.BorderSizePixel = 0 end
	if inst:IsA("GuiButton") then inst.AutoButtonColor = false end
	if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
		inst.Font = FONT
		inst.TextColor3 = T.Text
		inst.TextSize = 13
		inst.Text = ""
	end
	local parent
	for k, v in pairs(props) do
		if k == "Parent" then parent = v else inst[k] = v end
	end
	if children then
		for _, c in ipairs(children) do c.Parent = inst end
	end
	inst.Parent = parent
	return inst
end

local function corner(inst, r)
	return create("UICorner", { CornerRadius = UDim.new(0, r), Parent = inst })
end

local function stroke(inst, color, thickness, transparency)
	return create("UIStroke", {
		Color = color, Thickness = thickness or 1, Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = inst,
	})
end

local function padding(inst, l, t, r, b)
	return create("UIPadding", {
		PaddingLeft = UDim.new(0, l), PaddingTop = UDim.new(0, t or l),
		PaddingRight = UDim.new(0, r or l), PaddingBottom = UDim.new(0, b or t or l),
		Parent = inst,
	})
end

local function vlist(inst, gap)
	return create("UIListLayout", { Padding = UDim.new(0, gap), SortOrder = Enum.SortOrder.LayoutOrder, Parent = inst })
end

local function esc(s)
	return (tostring(s):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"))
end

local function hitbox(parent, size)
	return create("TextButton", { BackgroundTransparency = 1, Size = size or UDim2.fromScale(1, 1), ZIndex = 2, Parent = parent })
end

---------------------------------------------------------------- library
local Library = { Flags = {} }

function Library:CreateWindow(opts)
	opts = opts or {}
	local title = opts.Title or "Pinkie"
	local subtitle = opts.Subtitle or ""
	local camera = workspace.CurrentCamera
	local viewport = camera and camera.ViewportSize or Vector2.new(1280, 720)
	local width = math.min(opts.Width or 640, viewport.X - 24)
	local height = math.min(opts.Height or 420, viewport.Y - 24)
	local TOP = 44

	local Window = {
		Tabs = {},
		ActiveTab = nil,
		Visible = true,
		Minimized = false,
		Accent = opts.Accent or Color3.fromRGB(255, 143, 186),
		ToggleKey = opts.ToggleKey or Enum.KeyCode.RightShift,
		_listening = 0,
	}

	local conns = {}
	local accentFns = {}
	local orders = setmetatable({}, { __mode = "k" })

	local function connect(signal, fn)
		local c = signal:Connect(fn)
		table.insert(conns, c)
		return c
	end

	-- runs fn now and again every time the accent color changes
	local function onAccent(fn)
		table.insert(accentFns, fn)
		fn()
	end

	local function nextOrder(parent)
		orders[parent] = (orders[parent] or 0) + 1
		return orders[parent]
	end

	-- shared drag handler (window, sliders, color picker)
	local activeDrag = nil
	connect(UserInputService.InputChanged, function(input)
		if activeDrag and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			activeDrag(input.Position, false)
		end
	end)

	local function drag(hit, cb)
		hit.InputBegan:Connect(function(input)
			if input.UserInputType ~= Enum.UserInputType.MouseButton1
				and input.UserInputType ~= Enum.UserInputType.Touch then
				return
			end
			activeDrag = cb
			local sf = hit:FindFirstAncestorWhichIsA("ScrollingFrame")
			if sf then sf.ScrollingEnabled = false end
			cb(input.Position, true)
			local c
			c = input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					c:Disconnect()
					if activeDrag == cb then activeDrag = nil end
					if sf then sf.ScrollingEnabled = true end
				end
			end)
		end)
	end

	------------------------------------------------------------ shell
