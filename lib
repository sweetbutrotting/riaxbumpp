			obj.Open = not obj.Open
			tween(row, 0.28, { Size = UDim2.new(1, 0, 0, obj.Open and (44 + PANEL_H + 10) or 36) })
		end)

		refresh(true)
		return obj
	end

	------------------------------------------------------------ tabs
	local function selectTab(tab)
		if Window.ActiveTab == tab then return end
		local prev = Window.ActiveTab
		Window.ActiveTab = tab
		if prev then prev:_show(false) end
		tab:_show(true)
		for _, t in ipairs(Window.Tabs) do t._paint(true) end
	end

	function Window:SelectTab(tab) selectTab(tab) end

	function Window:CreateTab(name, icon)
		local tab = { Name = name }
		table.insert(self.Tabs, tab)

		local btn = create("TextButton", {
			BackgroundColor3 = T.Element, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 32),
			LayoutOrder = #self.Tabs, Parent = TabList,
		})
		corner(btn, 6)
		local lbl = create("TextLabel", {
			BackgroundTransparency = 1, Text = name, TextColor3 = T.SubText, TextXAlignment = LEFT,
			TextTruncate = Enum.TextTruncate.AtEnd, Position = UDim2.fromOffset(icon and 34 or 12, 0),
			Size = UDim2.new(1, icon and -40 or -18, 1, 0), Parent = btn,
		})
		local img
		if icon then
			img = create("ImageLabel", {
				BackgroundTransparency = 1, Image = icon, AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.new(0, 10, 0.5, 0), Size = UDim2.fromOffset(16, 16), Parent = btn,
			})
		end

		local hovered = false
		local function paint(animate)
			local active = Window.ActiveTab == tab
			local textColor = active and T.OnAccent or (hovered and T.Text or T.SubText)
			apply(btn, {
				BackgroundColor3 = active and Window.Accent or T.Element,
				BackgroundTransparency = active and 0 or (hovered and 0.45 or 1),
			}, animate)
			apply(lbl, { TextColor3 = textColor }, animate)
			if img then apply(img, { ImageColor3 = textColor }, animate) end
		end
		tab._paint = paint
		btn.MouseEnter:Connect(function() hovered = true; paint(true) end)
		btn.MouseLeave:Connect(function() hovered = false; paint(true) end)
		btn.Activated:Connect(function() selectTab(tab) end)
		onAccent(function() paint(false) end)

		local page = create("CanvasGroup", {
			BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, GroupTransparency = 1, Parent = Pages,
		})
		local scroll = create("ScrollingFrame", {
			BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ScrollBarThickness = 3, ScrollBarImageTransparency = 0.2,
			CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollingDirection = Enum.ScrollingDirection.Y, Parent = page,
		})
		padding(scroll, 0, 0, 8, 6)
		vlist(scroll, 6)
		onAccent(function() scroll.ScrollBarImageColor3 = Window.Accent end)
		tab.Container = scroll

		function tab:_show(on)
			if on then
				page.Visible = true
				page.GroupTransparency = 1
				page.Position = UDim2.fromOffset(0, 12)
				tween(page, 0.3, { GroupTransparency = 0, Position = UDim2.new() })
			else
				page.Visible = false
			end
		end

		for fnName, fn in pairs(Elements) do
			tab[fnName] = function(_, o) return fn(scroll, o or {}) end
		end

		if #self.Tabs == 1 then selectTab(tab) end
		return tab
	end

	------------------------------------------------------------ window methods
	local visToken = nil
	function Window:SetVisible(v)
		if v == self.Visible then return end
		self.Visible = v
		local token = {}
		visToken = token
		if v then
			Main.Visible = true
			tween(Main, 0.25, { GroupTransparency = 0 })
			tween(Scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
		else
			tween(Main, 0.2, { GroupTransparency = 1 })
			tween(Scale, 0.2, { Scale = 0.94 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			task.delay(0.22, function()
				if visToken == token then Main.Visible = false end
			end)
		end
	end

	function Window:Toggle() self:SetVisible(not self.Visible) end

	function Window:SetMinimized(m)
		self.Minimized = m
		if m then
			tween(Main, 0.3, { Size = UDim2.fromOffset(width, TOP) })
			task.delay(0.3, function()
				if self.Minimized then Body.Visible = false end
			end)
		else
			Body.Visible = true
			tween(Main, 0.3, { Size = UDim2.fromOffset(width, height) })
		end
	end

	function Window:SetAccent(color)
		self.Accent = color
		for _, fn in ipairs(accentFns) do fn() end
	end

	function Window:SetToggleKey(key)
		self.ToggleKey = key
	end

	function Window:Notify(n)
		n = n or {}
		local duration = n.Duration or 4
		local item = create("Frame", {
			BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 64), LayoutOrder = math.floor(os.clock() * 1000), Parent = NotifHolder,
		})
		local card = create("Frame", {
			BackgroundColor3 = T.Sidebar, Position = UDim2.new(1, 40, 0, 0), Size = UDim2.fromScale(1, 1),
			ClipsDescendants = true, Parent = item,
		})
		corner(card, 8)
		stroke(card, T.Stroke, 1)
		create("Frame", { BackgroundColor3 = self.Accent, Size = UDim2.new(0, 3, 1, 0), Parent = card })
		create("TextLabel", {
			BackgroundTransparency = 1, Text = n.Title or "Notification", Font = FONT_BOLD, TextXAlignment = LEFT,
			TextTruncate = Enum.TextTruncate.AtEnd, Position = UDim2.fromOffset(14, 8), Size = UDim2.new(1, -24, 0, 16), Parent = card,
		})
		create("TextLabel", {
			BackgroundTransparency = 1, Text = n.Content or "", TextColor3 = T.SubText, TextSize = 12, TextWrapped = true,
			TextXAlignment = LEFT, TextYAlignment = Enum.TextYAlignment.Top, TextTruncate = Enum.TextTruncate.AtEnd,
			Position = UDim2.fromOffset(14, 26), Size = UDim2.new(1, -24, 0, 30), Parent = card,
		})
		local prog = create("Frame", {
			BackgroundColor3 = self.Accent, Position = UDim2.new(0, 0, 1, -2), Size = UDim2.new(1, 0, 0, 2), Parent = card,
		})
		tween(card, 0.45, { Position = UDim2.new() })
		tween(prog, duration, { Size = UDim2.new(0, 0, 0, 2) }, Enum.EasingStyle.Linear)
		task.delay(duration, function()
			tween(card, 0.35, { Position = UDim2.new(1, 40, 0, 0) }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
			task.wait(0.35)
			tween(item, 0.25, { Size = UDim2.new(1, 0, 0, 0) })
			task.wait(0.25)
			item:Destroy()
		end)
	end

	function Window:Destroy()
		self:SetVisible(false)
		task.delay(0.3, function()
			for _, c in ipairs(conns) do c:Disconnect() end
			gui:Destroy()
		end)
	end

	------------------------------------------------------------ interactions
	-- drag the window by its top bar
	local startMouse, startPos
	drag(Topbar, function(pos, began)
		if began then
			startMouse, startPos = pos, Main.Position
			return
		end
		if not startMouse then return end
		local d = pos - startMouse
		tween(Main, 0.08, {
			Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y),
		}, Enum.EasingStyle.Quad)
	end)

	minBtn.Activated:Connect(function() Window:SetMinimized(not Window.Minimized) end)
	closeBtn.Activated:Connect(function() Window:Destroy() end)

	-- hide / show keybind
	connect(UserInputService.InputBegan, function(input, gpe)
		if gpe or Window._listening > 0 then return end
		if Window.ToggleKey ~= Enum.KeyCode.Unknown and input.KeyCode == Window.ToggleKey then
			Window:Toggle()
		end
	end)

	-- open button for phones / tablets (no keyboard)
	local showMobile = opts.MobileButton
	if showMobile == nil then
		showMobile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	end
	if showMobile then
		local mb = create("TextButton", {
			Text = string.upper(string.sub(title, 1, 1)), Font = FONT_BOLD, TextSize = 18, TextColor3 = T.OnAccent,
			AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 8), Size = UDim2.fromOffset(40, 40), Parent = gui,
		})
		corner(mb, 20)
		onAccent(function() mb.BackgroundColor3 = Window.Accent end)
		mb.Activated:Connect(function() Window:Toggle() end)
	end

	-- open animation + welcome message
	tween(Main, 0.35, { GroupTransparency = 0 })
	tween(Scale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
	if opts.Welcome ~= false then
		task.delay(0.6, function()
			Window:Notify({
				Title = "Welcome, " .. LocalPlayer.DisplayName .. "!",
				Content = "Press " .. Window.ToggleKey.Name .. " to hide or show the menu.",
				Duration = 6,
			})
		end)
	end

	return Window
end

